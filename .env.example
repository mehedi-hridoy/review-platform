# ──────────────────────────────────────────
# Backend Environment Configuration
# ──────────────────────────────────────────
# Copy this file to backend/.env and update values

# PostgreSQL database connection URL
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/review_platform

# Project name (used in API docs)
PROJECT_NAME="Review Platform API"

# ──────────────────────────────────────────
# Frontend Environment Configuration
# ──────────────────────────────────────────
# Copy this file to frontend/.env.local and update values

# Backend API URL (must include /api prefix)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
